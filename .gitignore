# Ignore build files
*.str
*.o
*.map
*.hex
*.dis
*.bit
*.hwh

# Vivado project-generated files and folders
boards/**/mep-sdr.cache/
boards/**/mep-sdr.hw/
boards/**/mep-sdr.ip_user_files/
boards/**/mep-sdr.gen/
boards/**/mep-sdr.runs/
boards/**/mep-sdr.srcs/
boards/**/mep-sdr.xpr
boards/**/.Xil/
boards/**/.ipcache/
boards/**/.sim/
boards/**/project_*/        # auto-created scratch projects
boards/**/tmp*/             # scratch temp dirs

# Vivado/xsim command-line simulation (e.g. boards/ip/*/hdl/)
xsim.dir/
xvlog.pb
xelab.pb
*.wdb

# Ignore temp and log files
*.log
*.jou
*.swp
__pycache__/

# Ignore vscode files
*.code-workspace
